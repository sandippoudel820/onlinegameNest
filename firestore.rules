rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Games catalog is readable by all public visitors
    match /games/{gameId} {
      allow read: if true;
      allow write: if false; // Only admin backend can modify catalog
    }

    // High scores are public to read and anyone can submit a new score
    match /highScores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.gameSlug is string
                    && request.resource.data.playerName is string
                    && request.resource.data.score is number;
      allow update, delete: if false;
    }

    // Contact messages can be submitted by visitors
    match /contacts/{contactId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
